{
  "$schema": "https://raw.githubusercontent.com/QuestPackageManager/QPM.Package/refs/heads/main/qpm.schema.json",
  "version": "0.1.0",
  "sharedDir": "shared",
  "dependenciesDir": "extern",
  "info": {
    "name": "Replay",
    "id": "replay",
    "version": "0.5.4",
    "url": "https://github.com/Metalit/Replay",
    "additionalData": {
      "overrideSoName": "libreplay.so",
      "cmake": true
    }
  },
  "workspace": {
    "scripts": {
      "build": [
        "pwsh ./scripts/build.ps1 $0?"
      ],
      "copy": [
        "pwsh ./scripts/copy.ps1 $0:?",
        "pwsh ./scripts/restart-game.ps1"
      ],
      "del": [
        "pwsh ./scripts/delete.ps1",
        "pwsh ./scripts/restart-game.ps1"
      ],
      "log": [
        "pwsh ./scripts/start-logging.ps1 $0:?"
      ],
      "qmod": [
        "pwsh ./scripts/build.ps1 $0?",
        "pwsh ./scripts/createqmod.ps1"
      ],
      "restart": [
        "pwsh ./scripts/restart-game.ps1"
      ],
      "stack": [
        "pwsh ./scripts/ndk-stack.ps1 $0?"
      ],
      "tomb": [
        "pwsh ./scripts/pull-tombstone.ps1 -analyze"
      ]
    },
    "ndk": "^29.0.14206865",
    "qmodIncludeDirs": [
      "./build",
      "./extern/libs"
    ],
    "qmodIncludeFiles": [],
    "qmodOutput": "replay.qmod"
  },
  "dependencies": [
    {
      "id": "beatsaber-hook",
      "versionRange": "^9.4.3",
      "additionalData": {}
    },
    {
      "id": "scotland2",
      "versionRange": "^0.1.7",
      "additionalData": {
        "includeQmod": false
      }
    },
    {
      "id": "bs-cordl",
      "versionRange": "^4600.0.0",
      "additionalData": {}
    },
    {
      "id": "paper2_scotland2",
      "versionRange": "^4.8.0",
      "additionalData": {}
    },
    {
      "id": "custom-types",
      "versionRange": "^0.21.2",
      "additionalData": {}
    },
    {
      "id": "sombrero",
      "versionRange": "^0.2.0",
      "additionalData": {}
    },
    {
      "id": "conditional-dependencies",
      "versionRange": "^0.3.0",
      "additionalData": {}
    },
    {
      "id": "hollywood",
      "versionRange": "^1.3.1",
      "additionalData": {}
    },
    {
      "id": "config-utils",
      "versionRange": "^3.0.0",
      "additionalData": {}
    },
    {
      "id": "bsml",
      "versionRange": "^0.6.8",
      "additionalData": {}
    },
    {
      "id": "metacore",
      "versionRange": "^2.0.7",
      "additionalData": {}
    },
    {
      "id": "web-utils",
      "versionRange": "^0.6.10",
      "additionalData": {}
    },
    {
      "id": "flamingo",
      "versionRange": "^1.3.1",
      "additionalData": {}
    },
    {
      "id": "reflectcpp",
      "versionRange": "^0.25.0",
      "additionalData": {}
    },
    {
      "id": "metacore-bs",
      "versionRange": "^1.0.4",
      "additionalData": {}
    },
    {
      "id": "autohooks",
      "versionRange": "^0.1.2533291970461696",
      "additionalData": {}
    }
  ]
}
